generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* =========================
   ENUMS
========================= */

enum ContactStatus {
  NEW
  INTRO_SENT
  CONSENTED
  DECLINED
  BLOCKED
  ASSIGNED
  SAMPLES_SENT
  FOLLOW_UP_SENT
  RESPONDED_AFTER_FOLLOWUP
  NEGOTIATING
  CONVERTED
  LOST
  ERROR
  ARCHIVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum UserRole {
  OWNER
  ADMIN
  SALES_REP

}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}
enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}
enum PromotionDiscountType {
  PERCENTAGE
  FIXED
}
enum WhatsappStatus {
  VERIFIED
  PENDING
  REJECTED
}
enum MessagingTier {
  TIER_1
  TIER_2
  TIER_3
}
enum WhatsappSetupStep {
  WABA_CONNECTED
  WEBHOOK_CONFIGURED
  PHONE_NUMBER_ADDED
  PHONE_NUMBER_VERIFIED
}

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
}


/* =========================
   ORGANIZATIONS (TENANTS)
========================= */

model Organization {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  plan            String   @default("FREE")

  whatsappStepsCompleted    WhatsappSetupStep[]
  whatsappBusinessAccountId String?  // Meta WABA ID
  whatsappStatus            WhatsappStatus?  @default(PENDING)
  messagingTier             MessagingTier?  // TIER_1 | TIER_2 | TIER_3
  webhookVerifyToken        String?  // for webhook validation
  accessToken               String?  // for API calls (if needed)
  accessTokenExpiresAt     DateTime? // token expiration time

  users           User[]
  contacts        Contact[]
  salesReps       SalesRep[]
  campaigns       Campaign[]
  messages        Message[]
  whatsAppNumbers WhatsAppNumber[]
  subscription    Subscription?
  whatsappTemplates WhatsAppTemplate[]
  payments        Payment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/* =========================
   USERS (AUTH & ACCESS)
========================= */

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String?
  googleId       String?  @unique
  role           UserRole @default(ADMIN)

  organizationId String?   
  organization   Organization? @relation(fields: [organizationId], references: [id])

  salesRep       SalesRep?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

/* =========================
   SUBSCRIPTIONS
========================= */

model Subscription {
  id                   String   @id @default(uuid())
  organizationId       String   @unique
  organization         Organization @relation(fields: [organizationId], references: [id])

  status               SubscriptionStatus @default(TRIAL)
  plan                 String
  messageLimit         Int
  messagesUsed         Int      @default(0)

  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime

  provider             String   // stripe | paystack | flutterwave
  providerRef          String?

  payments             Payment[]

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BillingPlan {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  description  String?
  messageLimit Int
  amount       Int
  currency     String   @default("USD")
  periodDays   Int      @default(30)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  metadata     Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, sortOrder])
}

model Promotion {
  id            String                @id @default(uuid())
  code          String                @unique
  description   String?
  discountType  PromotionDiscountType @default(PERCENTAGE)
  discountValue Int
  active        Boolean               @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  maxUses       Int?
  metadata      Json?

  payments      Payment[]

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Payment {
  id                String        @id @default(uuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  promotionId       String?
  promotion         Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  provider          String        @default("pesapal")
  status            PaymentStatus @default(PENDING)
  planCode          String
  messageLimit      Int
  periodDays        Int           @default(30)
  originalAmount    Int?
  discountAmount    Int           @default(0)
  amount            Int
  currency          String        @default("USD")
  promotionCode     String?
  merchantReference String        @unique
  orderTrackingId   String?       @unique
  providerReference String?
  paymentMethod     String?
  paymentAccount    String?
  paidAt            DateTime?
  expiresAt         DateTime?
  failureReason     String?
  metadata          Json?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([organizationId, createdAt])
  @@index([status])
  @@index([promotionId])
  @@index([promotionCode])
}

/* =========================
   WHATSAPP NUMBERS
========================= */

model WhatsAppNumber {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  phoneNumber    String       @unique
  phoneNumberId  String       @unique  // WhatsApp Business API ID
  accessToken    String?      // token specific to this number if needed
  displayName    String?      // optional display name
  accessTokenExpiresAt DateTime? 
  active         Boolean      @default(true)
  isPrimary      Boolean      @default(false)

  messages       Message[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}
model WhatsAppTemplate {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String   // exact Meta template name
  language       String   // en, en_US
  content        String?
  metaTemplateId String?
  status         TemplateStatus @default(PENDING)
  rejectionReason String?
  category       String   // MARKETING, UTILITY
  description    String?
  bodyParamsCount Int @default(1)
  bodyParamKeys   Json? 
  usageCount     Int @default(0)


  active         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaigns      Campaign[]

  @@unique([organizationId, name])
}


/* =========================
   CONTACTS (LEADS)
========================= */

model Contact {
  id               String        @id @default(uuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])

  name             String
  phone            String
  email            String?

  status           ContactStatus @default(NEW)
  consent          Boolean       @default(false)
  converted        Boolean       @default(false)

  samplesSentAt    DateTime?
  followUpSentAt   DateTime?

  salesRepId       String?
  salesRep         SalesRep?     @relation(fields: [salesRepId], references: [id])

  messages         Message[]
  campaigns        CampaignContact[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([organizationId, phone])
  @@index([phone])
  @@index([status])
  @@index([organizationId])
}

/* =========================
   SALES REPS
========================= */

model SalesRep {
  id             String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id])

  name           String
  phone          String     @unique
  email          String?
  active         Boolean    @default(true)

  contacts       Contact[]
  messages       Message[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([organizationId])
}


/* =========================
   MESSAGES (LOGS)
========================= */

model Message {
  id                 String           @id @default(uuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])

  contactId          String
  contact            Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)

  salesRepId         String?
  salesRep           SalesRep?        @relation(fields: [salesRepId], references: [id])

  whatsappNumberId   String
  whatsappNumber     WhatsAppNumber   @relation(fields: [whatsappNumberId], references: [id])

  direction          MessageDirection
  message            String

  createdAt          DateTime         @default(now())
  readAt             DateTime?

  @@index([contactId])
  @@index([direction])
  @@index([organizationId])
  @@index([salesRepId])
  @@index([whatsappNumberId])
}


/* =========================
   CAMPAIGNS
========================= */

model Campaign {
  id             String     @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  description    String?

  templateId     String?
  template       WhatsAppTemplate? @relation(fields: [templateId], references: [id])
  templateName   String?
  status         CampaignStatus @default(DRAFT)
  state          String    @default("DRAFT")

  messagesSent      Int      @default(0)
  messagesDelivered Int      @default(0)
  messagesRead      Int      @default(0)
  messagesFailed    Int      @default(0)

  sendLimit         Int?
  sendDelayMs       Int      @default(500)
  queueRequestedAt  DateTime?
  startedAt         DateTime?
  pausedAt          DateTime?
  canceledAt        DateTime?
  lastProgressAt    DateTime?
  lastError         String?
  workerLockId      String?
  workerLockedAt    DateTime?

  contacts       CampaignContact[]

  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  completedAt    DateTime?

  @@index([organizationId])
}

/* =========================
   CAMPAIGN ↔ CONTACT JOIN
========================= */

model CampaignContact {
  id          String    @id @default(uuid())

  campaignId  String
  contactId   String

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  assignedAt  DateTime  @default(now())
  sendStatus  String    @default("PENDING")
  sendAttempts Int      @default(0)
  lastAttemptAt DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  lastError   String?
  outboundMessageId String?

  @@unique([campaignId, contactId])
  @@index([campaignId, sendStatus])
  @@index([outboundMessageId])
}
