  "item": [
    {
      "name": "Get Assigned Contacts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/messages/contacts",
          "host": ["{{baseUrl}}"],
          "path": ["messages", "contacts"],
          "query": [
            {
              "key": "status",
              "value": "ASSIGNED",
              "description": "Filter by contact status (optional)",
              "disabled": true
            }
          ]
        },
        "description": "Get all contacts assigned to the sales rep with unread message counts"
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/messages/contacts",
              "host": ["{{baseUrl}}"],
              "path": ["messages", "contacts"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n    \"status\": \"success\",\n    \"data\": {\n        \"contacts\": [\n            {\n                \"id\": \"uuid-here\",\n                \"name\": \"John Doe\",\n                \"phone\": \"+1234567890\",\n                \"email\": \"john@example.com\",\n                \"status\": \"ASSIGNED\",\n                \"consent\": true,\n                \"converted\": false,\n                \"unreadCount\": 3,\n                \"totalMessages\": 15,\n                \"createdAt\": \"2026-01-29T10:00:00.000Z\",\n                \"updatedAt\": \"2026-01-30T14:30:00.000Z\"\n            }\n        ]\n    }\n}"
        }
      ]
    },
