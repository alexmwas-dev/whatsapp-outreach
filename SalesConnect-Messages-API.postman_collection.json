{
  "info": {
    "_postman_id": "messages-api-collection",
    "name": "SalesConnect Messages API",
    "description": "Sales rep messaging endpoints for chatting with assigned contacts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
