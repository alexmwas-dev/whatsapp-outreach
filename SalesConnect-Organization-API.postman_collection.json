{
  "info": {
    "_postman_id": "salesconnect-organization-api",
    "name": "SalesConnect Organization API",
    "description": "Organization management, team members, and statistics endpoints for SalesConnect",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Organization",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme Inc\",\n  \"slug\": \"acme-inc\",\n  \"plan\": \"FREE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization",
              "host": ["{{base_url}}"],
              "path": ["organization"]
            },
            "description": "Create a new organization and assign the authenticated user as OWNER."
          },
          "response": []
        },
        {
          "name": "Connect WhatsApp Business",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wabaId\": \"123456789012345\",\n  \"webhookToken\": \"your-verify-token\",\n  \"tier\": \"TIER_1\",\n  \"displayName\": \"SalesConnect\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization/connect-whatsapp",
              "host": ["{{base_url}}"],
              "path": ["organization", "connect-whatsapp"]
            },
            "description": "Connect WhatsApp Business (WABA) to the organization. Requires OWNER or ADMIN role."
          },
          "response": []
        },
        {
          "name": "Get Organization Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/organization",
              "host": ["{{base_url}}"],
              "path": ["organization"]
            },
            "description": "Retrieve organization details including team members and subscription info."
          },
          "response": []
        },
        {
          "name": "Update Organization",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Company Name\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization",
              "host": ["{{base_url}}"],
              "path": ["organization"]
            },
            "description": "Update organization name. Requires OWNER or ADMIN role."
          },
          "response": []
        },
        {
          "name": "Get Organization Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/organization/stats",
              "host": ["{{base_url}}"],
              "path": ["organization", "stats"]
            },
            "description": "Get organization usage statistics (contacts, campaigns, messages, templates, WhatsApp numbers, subscription)."
          },
          "response": []
        },
        {
          "name": "Add Contacts",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contacts\": [\n    {\"name\": \"Jane Doe\", \"phone\": \"+15555550123\", \"email\": \"jane@example.com\"},\n    {\"name\": \"John Doe\", \"phone\": \"+15555550124\"}\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization/contacts",
              "host": ["{{base_url}}"],
              "path": ["organization", "contacts"]
            },
            "description": "Add one or many contacts to the organization."
          },
          "response": []
        },
        {
          "name": "Get Activity Log",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/organization/activity",
              "host": ["{{base_url}}"],
              "path": ["organization", "activity"]
            },
            "description": "Get recent message activity log for the organization."
          },
          "response": []
        },
        {
          "name": "Add Sales Rep",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"phone\": \"+15555550111\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization/sales-reps",
              "host": ["{{base_url}}"],
              "path": ["organization", "sales-reps"]
            },
            "description": "Add a sales rep to the organization. Requires OWNER or ADMIN role."
          },
          "response": []
        }
      ],
      "description": "Organization management and statistics"
    },
    {
      "name": "Team Members",
      "item": [
        {
          "name": "Get Team Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/organization/team",
              "host": ["{{base_url}}"],
              "path": ["organization", "team"]
            },
            "description": "List all team members with their roles."
          },
          "response": []
        },
        {
          "name": "Invite Team Member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@company.com\",\n  \"role\": \"SALES_REP\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization/team/invite",
              "host": ["{{base_url}}"],
              "path": ["organization", "team", "invite"]
            },
            "description": "Invite a new team member. Role can be ADMIN or SALES_REP. Requires OWNER or ADMIN role."
          },
          "response": []
        },
        {
          "name": "Update Team Member Role",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/organization/team/{{memberId}}/role",
              "host": ["{{base_url}}"],
              "path": ["organization", "team", "{{memberId}}", "role"]
            },
            "description": "Update a team member's role. Requires OWNER or ADMIN role."
          },
          "response": []
        },
        {
          "name": "Remove Team Member",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/organization/team/{{memberId}}",
              "host": ["{{base_url}}"],
              "path": ["organization", "team", "{{memberId}}"]
            },
            "description": "Remove a team member from the organization. Requires OWNER role only."
          },
          "response": []
        }
      ],
      "description": "Team member management"
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token from login or signup"
    },
    {
      "key": "memberId",
      "value": "",
      "type": "string",
      "description": "Team member ID"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "User ID (for sales rep creation)"
    }
  ]
}
